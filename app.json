{
  "expo": {
    "name": "Esportes Da Sorte",
    "slug": "deporteslasport",
    "scheme": "deporteslasport",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo2.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#043494",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dddeportessslasporttt",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dddeportessslasporttt",
      "adaptiveIcon": {
        "backgroundColor": "#043494",
        "foregroundImage": "./assets/logo2.png",
        "backgroundImage": "./assets/logo2.png",
        "monochromeImage": "./assets/logo2.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/logo2.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#043494"
        }
      ],
      "expo-font",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às fotos para escolher a foto dos jogadores e o emblema da equipa.",
          "cameraPermission": "Permitir acesso à câmara para fotografar os jogadores e o emblema da equipa."
        }
      ],
      "./plugins/withUnifiedNdkVersion",
      "./plugins/withQuietDevMenu",
      "./plugins/withGradleMemory",
      "./plugins/withCodemagicSigning",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24
          }
        }
      ],
      "react-native-appsflyer",
      "@react-native-firebase/app",
      "./plugins/withAppsFlyerKotlin"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "03f45169-f954-4af7-be52-3324d3c370b3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/03f45169-f954-4af7-be52-3324d3c370b3"
    }
  }
}
